{
  "name": "glass-keys",
  "version": "1.0.0",
  "description": "Learn to type with animated glass hands. Works offline.",
  "author": "Glass Keys",
  "license": "MIT",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder" },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.glasskeys.app",
    "productName": "Glass Keys",
    "files": ["main.js", "index.html"],
    "directories": { "output": "dist", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "artifactName": "Glass-Keys-${version}-mac.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Glass-Keys-${version}-windows-setup.${ext}"
    },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
